# Port the proxy listens on. Render sets this for you.
PORT=5000

# Comma-separated list of browser origins allowed to call this proxy.
# Set this to your deployed frontend URL in production. "*" disables the check.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sent to Transitous with every request. Their usage policy REQUIRES a
# User-Agent containing the application name, its version, and a way to
# contact you (an email address or a website/repository URL) — requests
# without one can be blocked. Change the URL if you fork this project.
USER_AGENT=TransitFlow/2.0 (+https://github.com/Dremo-drizzy/German-Api-project)

# Per-IP request budget for /api, per minute.
RATE_LIMIT_PER_MINUTE=120

# How long to wait for Transitous before giving up, in milliseconds.
UPSTREAM_TIMEOUT_MS=12000

# (No upstream URL setting: the data source is Transitous, called in-process
# through motis-fptf-client. See docs/data-sources.md.)
