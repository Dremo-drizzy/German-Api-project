# Port the proxy listens on. Render sets this for you.
PORT=5000

# Upstream transit API.
BASE_API=https://v6.db.transport.rest

# Comma-separated list of browser origins allowed to call this proxy.
# Set this to your deployed frontend URL in production. "*" disables the check.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sent upstream so transport.rest can identify the client, as their docs ask.
USER_AGENT=TransitFlow/2.0 (+https://github.com/Dremo-drizzy/German-Api-project)

# Per-IP request budget for /api, per minute.
RATE_LIMIT_PER_MINUTE=120

# How long to wait for the upstream API before giving up, in milliseconds.
UPSTREAM_TIMEOUT_MS=12000
