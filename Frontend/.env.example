# Base URL for the transit API. Leave unset to use the Vite dev proxy at /api,
# which forwards to the local Backend/ Express server (see vite.config.js).
# Set this to a deployed backend URL (e.g. https://german-api-project.onrender.com/api)
# for builds that should talk to a remote proxy instead of a local one.
VITE_API_BASE_URL=
